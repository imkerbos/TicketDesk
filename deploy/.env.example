# ============================================================
# TicketDesk 生产环境配置
# ============================================================
# 使用方式：
#   1. cp .env.example .env
#   2. 修改下方配置（尤其是密码和密钥）
#   3. docker compose up -d（或在项目根目录执行 make prod-d）
# ============================================================

# ============ 数据库配置 ============
# MySQL root 密码
DB_ROOT_PASSWORD=ticketdesk_root_2026
# 应用数据库名
DB_NAME=ticketdesk
# 应用数据库用户
DB_USER=ticketdesk
# 应用数据库密码
DB_PASSWORD=ticketdesk_pwd_2026

# ============ Redis 配置 ============
REDIS_PASSWORD=ticketdesk_redis_2026
REDIS_DB=0

# ============ JWT 配置（生产环境必须修改！）============
# 请生成一个随机字符串作为 JWT 密钥
# 可使用命令：openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-in-production
# Access Token 有效期（秒）- 默认 2 小时
JWT_ACCESS_EXPIRE=7200
# Refresh Token 有效期（秒）- 默认 7 天
JWT_REFRESH_EXPIRE=604800

# ============ 应用配置 ============
# 后端服务端口（容器内部端口，一般不需要修改）
APP_PORT=10010
# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# ============ 前端配置 ============
# 前端对外暴露的端口（宿主机端口）
WEB_PORT=80

# ============ 夜莺告警集成（可选）============
# 是否启用夜莺告警拉取
# N9E_ENABLE=false
# 夜莺服务地址
# N9E_BASE_URL=http://n9e-server:17000
# 夜莺 API Token
# N9E_TOKEN=your-n9e-api-token
# 告警拉取间隔（秒）
# N9E_POLL_INTERVAL=30
